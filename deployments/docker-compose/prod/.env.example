# VPS deploy. Copy to `.env` in this same directory (deployments/docker-compose/prod/)
# — `docker compose` auto-loads it from there. Never commit the real file.

# --- Postgres (also used by docker-compose.yml directly) ---
POSTGRES_USER=virdan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=virdanproject

# --- MinIO (also used by docker-compose.yml directly) ---
MINIO_USER=change-me
MINIO_PASSWORD=change-me

# --- Grafana / Cloudflare tunnel (used by docker-compose.yml directly) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
CLOUDFLARE_TUNNEL_TOKEN=

# --- App container env (passed via env_file, same vars the Go binary reads) ---
GO_SERVER=:8081
APP_BASE_URL=https://virdan.cloud

POSTGRES_URL=postgres://virdan:change-me@postgres:5432/virdanproject?sslmode=disable
REDIS_URL=redis:6379

MINIO_INTERNAL_URL=minio:9000
MINIO_URL=cdn.virdan.cloud
MINIO_HTTP=https://
MINIO_BUCKET_NAME=virdan
MINIO_LOCATION=us-east-1

JWT_SECRET_KEY=change-me

LOG_LEVEL=info
OTEL_SERVICE_NAME=virdanproject
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4318
OTEL_LOG_BATCH_TIMEOUT=5s
OTEL_LOG_BATCH_EXPORT_TIMEOUT=30s
OTEL_LOG_BATCH_MAX_QUEUE_SIZE=2048
OTEL_METRIC_INTERVAL=15s
OTEL_TRACE_BATCH_TIMEOUT=5s
OTEL_TRACE_BATCH_EXPORT_TIMEOUT=30s
OTEL_TRACE_MAX_QUEUE_SIZE=2048
OTEL_TRACE_SAMPLE_RATE=0.1

FIREBASE_SERVICE_ACCOUNT_BASE64_JSON=

SMTP_HOST=
SMTP_PORT=587
SENDER_NAME=Virdan
SENDER_EMAIL=noreply@virdan.cloud
SENDER_PASSWORD=

XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_SUCCESS_URL=https://virdan.cloud/payment/success
XENDIT_CANCEL_URL=https://virdan.cloud/payment/cancel
