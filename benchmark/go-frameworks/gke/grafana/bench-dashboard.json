    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU usage (% of limit)",
      "description": "cAdvisor sample timestamps lag the real measurement by up to ~10 s, so values can read about 15% high or low; readings above 100% are measurement artifacts.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (framework) (label_replace(rate(container_cpu_usage_seconds_total{namespace=\"bench\", container=\"app\"}[1m]), \"framework\", \"$1\", \"pod\", \"(.+)-[a-z0-9]+-[a-z0-9]+\")) / sum by (framework) (label_replace(container_spec_cpu_quota{namespace=\"bench\", container=\"app\"} / container_spec_cpu_period{namespace=\"bench\", container=\"app\"}, \"framework\", \"$1\", \"pod\", \"(.+)-[a-z0-9]+-[a-z0-9]+\"))",
          "legendFormat": "{{framework}}",
          "datasource": {
