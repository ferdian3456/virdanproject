# Root .env — for running the app directly on the host: `go run ./cmd`
# Pairs with `docker compose up -d` in deployments/docker-compose/local
# (infra only, no app container) — hosts below use localhost + mapped ports.

GO_SERVER=:8081
APP_BASE_URL=http://localhost:8081

# --- Database / cache / storage ---
POSTGRES_URL=postgres://ferdian:ferdian123@localhost:5435/virdanproject?sslmode=disable
REDIS_URL=localhost:6379

MINIO_INTERNAL_URL=localhost:9000
MINIO_URL=localhost:9000
MINIO_HTTP=http://
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET_NAME=virdan
MINIO_LOCATION=us-east-1

# --- Auth ---
JWT_SECRET_KEY=dev-secret-change-me

# --- Logging / OTel (otel-collector exposed on localhost in local compose) ---
LOG_LEVEL=info
OTEL_SERVICE_NAME=virdanproject
OTEL_SERVICE_VERSION=dev
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
OTEL_LOG_BATCH_TIMEOUT=5s
OTEL_LOG_BATCH_EXPORT_TIMEOUT=30s
OTEL_LOG_BATCH_MAX_QUEUE_SIZE=2048
OTEL_METRIC_INTERVAL=15s
OTEL_TRACE_BATCH_TIMEOUT=5s
OTEL_TRACE_BATCH_EXPORT_TIMEOUT=30s
OTEL_TRACE_MAX_QUEUE_SIZE=2048
OTEL_TRACE_SAMPLE_RATE=1.0

# --- Firebase (push notifications) ---
FIREBASE_SERVICE_ACCOUNT_BASE64_JSON=

# --- SMTP (OTP / email) ---
SMTP_HOST=
SMTP_PORT=587
SENDER_NAME=Virdan
SENDER_EMAIL=noreply@virdan.test
SENDER_PASSWORD=

# --- Xendit (Virdan Plus one-time payment) ---
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XENDIT_WEBHOOK_TOKEN=dev-webhook-token
XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_SUCCESS_URL=https://virdan.cloud/payment/success
XENDIT_CANCEL_URL=https://virdan.cloud/payment/cancel
