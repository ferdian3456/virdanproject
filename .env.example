# Server Configuration
GO_SERVER=:8080

# Database Configuration
# Use this when running the app directly (not with Docker Compose)
# POSTGRES_URL=postgres://postgres:password@localhost:5432/cutterproject?sslmode=disable

# Use this when running with Docker Compose
POSTGRES_URL=postgres://postgres:password@postgres:5432/cutterproject?sslmode=disable

# Redis Configuration
# Use this when running the app directly (not with Docker Compose)
# REDIS_URL=redis://localhost:6379

# Use this when running with Docker Compose
REDIS_URL=redis://redis:6379

# Logging Configuration
LOG_LEVEL=info

# JWT Configuration (for future implementation)
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=24h

# Application Configuration
APP_NAME=Cutter Project
APP_ENV=development

# Firebase (choose one)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Xendit (Virdan Plus one-time payment)
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XENDIT_WEBHOOK_TOKEN=your_xendit_webhook_verification_token
XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_SUCCESS_URL=https://virdan.cloud/payment/success
XENDIT_CANCEL_URL=https://virdan.cloud/payment/cancel